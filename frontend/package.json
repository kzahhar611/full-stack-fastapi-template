{
  "name": "tenderwise-ai-frontend",
  "version": "1.0.0",
  "description": "TenderWise AI - Enterprise Frontend for RFP & Tendering Platform",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.svelte",
    "lint:fix": "eslint . --ext .js,.ts,.svelte --fix",
    "format": "prettier --write .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type-check": "tsc --noEmit",
    "i18n:extract": "i18next-parser",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@storybook/addon-essentials": "^7.5.0",
    "@storybook/addon-interactions": "^7.5.0",
    "@storybook/addon-links": "^7.5.0",
    "@storybook/blocks": "^7.5.0",
    "@storybook/svelte": "^7.5.0",
    "@storybook/svelte-vite": "^7.5.0",
    "@storybook/test": "^7.5.0",
    "@sveltejs/adapter-auto": "^2.1.1",
    "@sveltejs/kit": "^1.27.4",
    "@sveltejs/vite-plugin-svelte": "^2.5.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/d3": "^7.4.3",
    "@types/fabric": "^5.3.7",
    "@types/node": "^20.8.10",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-storybook": "^0.6.15",
    "eslint-plugin-svelte": "^2.35.1",
    "i18next-parser": "^8.8.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "prettier-plugin-svelte": "^3.1.0",
    "storybook": "^7.5.0",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^3.3.5",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.5.3",
    "@internationalized/date": "^3.5.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tanstack/svelte-query": "^5.8.4",
    "@xyflow/svelte": "^0.0.39",
    "bits-ui": "^0.11.8",
    "clsx": "^2.0.0",
    "cmdk-sv": "^0.0.12",
    "d3": "^7.8.5",
    "fabric": "^5.3.0",
    "formsnap": "^0.4.1",
    "i18next": "^23.6.0",
    "lucide-svelte": "^0.292.0",
    "mode-watcher": "^0.2.2",
    "paneforge": "^0.0.2",
    "socket.io-client": "^4.7.4",
    "svelte-french-toast": "^1.2.0",
    "svelte-i18n": "^4.0.0",
    "svelte-persisted-store": "^0.7.0",
    "svelte-sonner": "^0.3.16",
    "sveltekit-superforms": "^1.13.1",
    "tailwind-merge": "^2.0.0",
    "tailwind-variants": "^0.1.18",
    "uuid": "^9.0.1",
    "vaul-svelte": "^0.2.0",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "keywords": [
    "tenderwise",
    "ai",
    "rfp",
    "tendering",
    "svelte",
    "typescript",
    "workflow",
    "enterprise"
  ],
  "author": "TenderWise AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tenderwise-ai.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/your-org/tenderwise-ai/issues"
  },
  "homepage": "https://tenderwise.ai"
