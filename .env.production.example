# TenderWise AI - Production Environment Configuration
# Copy this file to .env and update with your production values

# Application Settings
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-super-secret-key-here-change-this-in-production
APP_NAME=TenderWise AI
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:your-postgres-password@db:5432/tenderwise_ai
POSTGRES_PASSWORD=your-postgres-password-here

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# AI Service API Keys (required)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional AI Services
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Security Settings
CORS_ORIGINS=["https://yourdomain.com", "https://app.yourdomain.com"]
ALLOWED_HOSTS=["yourdomain.com", "*.yourdomain.com"]

# File Upload Settings
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "csv", "jpg", "jpeg", "png", "gif", "webp"]

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password

# Performance Settings
WORKERS=4
MAX_CONNECTIONS=100
KEEPALIVE_TIMEOUT=65

# Cache Settings
CACHE_TTL=300  # 5 minutes default
CACHE_MAX_SIZE=1000  # Maximum number of cached items

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# SSL/TLS Settings (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Backup Settings
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Monitoring and Alerting
MONITORING_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Development overrides (only for development)
# DEBUG=true
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]