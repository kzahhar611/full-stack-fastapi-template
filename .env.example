# TenderWise AI - Environment Configuration

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=true
ENABLE_CORS=true

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
API_V1_STR=/api/v1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
DATABASE_URL=postgresql://tenderwise:password@localhost:5432/tenderwise_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis for caching and sessions
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Vector Database for RAG
VECTOR_DB_URL=postgresql://tenderwise:password@localhost:5432/tenderwise_vectors
# Alternative: Qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# LDAP Configuration (Enterprise)
LDAP_SERVER=ldap://your-ldap-server:389
LDAP_USER_DN=ou=users,dc=company,dc=com
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=your-ldap-password

# =============================================================================
# AI PROVIDERS CONFIGURATION
# =============================================================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id
OPENAI_MODEL_DEFAULT=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL_DEFAULT=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4000

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-key
GOOGLE_AI_MODEL_DEFAULT=gemini-pro

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_DEFAULT=llama2

# Hugging Face
HUGGINGFACE_API_KEY=your-huggingface-key
HUGGINGFACE_MODEL_DEFAULT=microsoft/DialoGPT-medium

# =============================================================================
# LLM USAGE & COST MANAGEMENT
# =============================================================================
# Cost Tracking
ENABLE_COST_TRACKING=true
MONTHLY_COST_LIMIT_USD=1000
COST_ALERT_THRESHOLD=0.8

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# =============================================================================
# WORKFLOW ENGINE CONFIGURATION
# =============================================================================
# Workflow Execution
WORKFLOW_MAX_NODES=100
WORKFLOW_TIMEOUT_SECONDS=300
WORKFLOW_RETRY_ATTEMPTS=3
ENABLE_WORKFLOW_CACHING=true

# Celery (Task Queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
# File Storage
STORAGE_TYPE=local  # local, s3, azure, gcp
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,docx,pptx,txt,md

# AWS S3 (if using S3 storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=tenderwise-documents
AWS_REGION=us-west-2

# Document Processing
ENABLE_OCR=true
OCR_LANGUAGE=eng+ara  # English + Arabic
PDF_DPI=300
MAX_PAGES_PER_DOCUMENT=500

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false

# Email Templates
FROM_EMAIL=noreply@tenderwise.ai
FROM_NAME=TenderWise AI
SUPPORT_EMAIL=support@tenderwise.ai

# =============================================================================
# MULTI-TENANCY & ORGANIZATIONS
# =============================================================================
# Default Organization
DEFAULT_ORG_NAME=TenderWise AI
DEFAULT_ORG_CURRENCY=SAR
DEFAULT_ORG_LANGUAGE=en
DEFAULT_ORG_TIMEZONE=Asia/Riyadh

# Entity Management
MAX_ENTITIES_PER_USER=5
ENABLE_ENTITY_ISOLATION=true

# =============================================================================
# INTERNATIONALIZATION
# =============================================================================
# Supported Languages
SUPPORTED_LANGUAGES=en,ar
DEFAULT_LANGUAGE=en
ENABLE_RTL_SUPPORT=true

# Calendar Systems
ENABLE_HIJRI_CALENDAR=true
ENABLE_GREGORIAN_CALENDAR=true
DEFAULT_CALENDAR_TYPE=gregorian

# Currency Support
SUPPORTED_CURRENCIES=SAR,USD,EUR,GBP
DEFAULT_CURRENCY=SAR

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=90

# Monitoring
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090

# Logging
LOG_FORMAT=json
LOG_FILE=./logs/tenderwise.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Core Features
ENABLE_WORKFLOW_DESIGNER=true
ENABLE_AI_AGENTS=true
ENABLE_DOCUMENT_TEMPLATES=true
ENABLE_PROPOSAL_GENERATION=true

# Advanced Features
ENABLE_REAL_TIME_COLLABORATION=false
ENABLE_ADVANCED_ANALYTICS=false
ENABLE_API_MARKETPLACE=false

# Enterprise Features
ENABLE_SSO=false
ENABLE_AUDIT_LOGGING=true
ENABLE_COMPLIANCE_TOOLS=false

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Development
RELOAD_ON_CHANGE=true
ENABLE_DEBUG_TOOLBAR=true
SHOW_SQL_QUERIES=false

# Testing
TEST_DATABASE_URL=postgresql://tenderwise:password@localhost:5432/tenderwise_ai_test
ENABLE_TEST_DATA=true
MOCK_AI_RESPONSES=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Docker
DOCKER_IMAGE_TAG=latest
DOCKER_REGISTRY=your-registry.com

# Kubernetes
KUBERNETES_NAMESPACE=tenderwise-ai
KUBERNETES_REPLICAS=3

# Health Checks
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=10

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_TYPE=s3  # local, s3, azure

# Disaster Recovery
ENABLE_CROSS_REGION_BACKUP=false
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key